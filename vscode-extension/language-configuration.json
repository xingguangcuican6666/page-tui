{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "'",
      "close": "'"
    }
  ],
  "surroundingPairs": [
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(children|pages|data|state|layout|keys|on|params|with|then|else):\\s*$",
    "decreaseIndentPattern": "^\\s*(type|value|bind|style|path|page|list|index|field|service|condition):"
  }
}
