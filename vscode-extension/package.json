{
  "name": "page-tui-vscode",
  "displayName": "Page TUI",
  "description": "为 Page TUI YAML 页面提供可视化编辑、补全、悬停说明、校验、实时预览、模板和运行命令。",
  "version": "0.2.28",
  "publisher": "xingguangcuican",
  "license": "MIT",
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "page-tui",
    "tui",
    "yaml",
    "nodejs"
  ],
  "activationEvents": [
    "onLanguage:page-tui-yaml",
    "onLanguage:yaml",
    "onCommand:pageTui.createStarter",
    "onCommand:pageTui.insertTemplate",
    "onCommand:pageTui.validate",
    "onCommand:pageTui.setLanguage",
    "onCommand:pageTui.preview",
    "onCommand:pageTui.openVisualEditor",
    "onCommand:pageTui.run",
    "onCommand:pageTui.openDocs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xingguangcuican6666/page-tui.git",
    "directory": "vscode-extension"
  },
  "scripts": {
    "build:webview": "node scripts/build-webview.js",
    "smoke:webview": "node scripts/smoke-workflow.js",
    "smoke:visual": "node scripts/smoke-visual-editor.js",
    "test": "node --test test/*.test.js",
    "vscode:prepublish": "npm run build:webview",
    "package": "npm run build:webview && npx @vscode/vsce package"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "contributes": {
    "configurationDefaults": {
      "[page-tui-yaml]": {
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        },
        "editor.suggest.snippetsPreventQuickSuggestions": false
      }
    },
    "languages": [
      {
        "id": "page-tui-yaml",
        "aliases": [
          "Page TUI YAML",
          "page-tui"
        ],
        "extensions": [
          ".page.yaml",
          ".page.yml"
        ],
        "filenames": [
          "page-tui.yaml",
          "page-tui.yml"
        ],
        "filenamePatterns": [
          "**/app.yaml",
          "**/app.yml",
          "**/ui/pages/**/*.yaml",
          "**/ui/pages/**/*.yml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "page-tui-yaml",
        "scopeName": "source.yaml.page-tui",
        "path": "./syntaxes/page-tui-yaml.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.yaml": "yaml"
        }
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": [
          "**/app.yaml",
          "**/app.yml",
          "**/ui/pages/**/*.yaml",
          "**/ui/pages/**/*.yml",
          "**/*.page.yaml",
          "**/*.page.yml"
        ],
        "url": "./schemas/page-tui.schema.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "pageTui.visualEditor",
        "displayName": "Page TUI 可视化编辑器",
        "selector": [
          {
            "filenamePattern": "**/app.yaml"
          },
          {
            "filenamePattern": "**/app.yml"
          },
          {
            "filenamePattern": "**/*.page.yaml"
          },
          {
            "filenamePattern": "**/*.page.yml"
          },
          {
            "filenamePattern": "**/ui/pages/**/*.yaml"
          },
          {
            "filenamePattern": "**/ui/pages/**/*.yml"
          }
        ],
        "priority": "option"
      }
    ],
    "snippets": [
      {
        "language": "page-tui-yaml",
        "path": "./snippets/page-tui-yaml.json"
      }
    ],
    "commands": [
      {
        "command": "pageTui.createStarter",
        "title": "Page TUI: 创建初学者页面"
      },
      {
        "command": "pageTui.insertTemplate",
        "title": "Page TUI: 插入页面模板"
      },
      {
        "command": "pageTui.validate",
        "title": "Page TUI: 校验当前页面"
      },
      {
        "command": "pageTui.setLanguage",
        "title": "Page TUI: 将当前文件设为 Page TUI YAML"
      },
      {
        "command": "pageTui.preview",
        "title": "Page TUI: 打开实时预览"
      },
      {
        "command": "pageTui.openVisualEditor",
        "title": "Page TUI: 打开可视化编辑器"
      },
      {
        "command": "pageTui.run",
        "title": "Page TUI: 运行当前项目"
      },
      {
        "command": "pageTui.openDocs",
        "title": "Page TUI: 打开中文文档"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "pageTui.createStarter"
        },
        {
          "command": "pageTui.insertTemplate",
          "when": "editorLangId == page-tui-yaml"
        },
        {
          "command": "pageTui.validate",
          "when": "editorLangId == page-tui-yaml"
        },
        {
          "command": "pageTui.setLanguage"
        },
        {
          "command": "pageTui.preview"
        },
        {
          "command": "pageTui.openVisualEditor"
        },
        {
          "command": "pageTui.run",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "pageTui.openDocs"
        }
      ],
      "editor/title": [
        {
          "command": "pageTui.validate",
          "when": "editorLangId == page-tui-yaml",
          "group": "navigation@1"
        },
        {
          "command": "pageTui.preview",
          "when": "editorLangId == page-tui-yaml",
          "group": "navigation@2"
        },
        {
          "command": "pageTui.openVisualEditor",
          "when": "editorLangId == page-tui-yaml",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Page TUI",
      "properties": {
        "pageTui.autoValidate": {
          "type": "boolean",
          "default": true,
          "description": "编辑 Page TUI YAML 时自动显示结构和动作诊断。"
        },
        "pageTui.runCommand": {
          "type": "string",
          "default": "npm start",
          "description": "执行“Page TUI: 运行当前项目”时发送到终端的命令。"
        },
        "pageTui.docsUrl": {
          "type": "string",
          "default": "https://github.com/xingguangcuican6666/page-tui/tree/main/docs",
          "description": "命令面板中打开的 Page TUI 文档地址。"
        }
      }
    }
  },
  "devDependencies": {
    "@xyflow/react": "^12.11.2",
    "esbuild": "^0.28.1",
    "lucide-react": "^1.28.0",
    "playwright": "^1.62.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
