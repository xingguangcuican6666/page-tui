{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/xingguangcuican6666/page-tui/blob/main/vscode-extension/schemas/page-tui.schema.json",
  "title": "Page TUI manifest",
  "description": "Page TUI YAML manifest and page definition.",
  "type": "object",
  "properties": {
    "initial": {
      "type": "string",
      "description": "应用启动时打开的页面名称。"
    },
    "data": {
      "type": "object",
      "description": "所有页面共享的数据。"
    },
    "i18n": {
      "$ref": "#/definitions/i18n"
    },
    "pages": {
      "type": "object",
      "description": "页面注册表。",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "description": "相对于当前 manifest 的独立 YAML 页面文件路径。"
          },
          {
            "$ref": "#/definitions/page"
          }
        ]
      }
    }
  },
  "definitions": {
    "value": {
      "description": "固定值、变量绑定、模板或嵌套对象。",
      "oneOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "object",
          "properties": {
            "bind": {
              "type": "string"
            },
            "template": {
              "type": "string"
            },
            "t": {
              "$ref": "#/definitions/value",
              "description": "语言文件中的翻译键。"
            },
            "i18n": {
              "$ref": "#/definitions/value",
              "description": "t 的别名。"
            },
            "with": {
              "$ref": "#/definitions/value",
              "description": "传入翻译模板的 params 参数。"
            },
            "params": {
              "$ref": "#/definitions/value",
              "description": "with 的别名。"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "array"
        }
      ]
    },
    "i18n": {
      "type": "object",
      "description": "外部语言模块和当前语言变量。",
      "properties": {
        "locale": {
          "$ref": "#/definitions/value",
          "description": "当前语言代码或 data/state/params 变量绑定。"
        },
        "language": {
          "$ref": "#/definitions/value",
          "description": "locale 的别名。"
        },
        "fallback": {
          "type": "string",
          "description": "翻译缺失时使用的默认语言。"
        },
        "default": {
          "type": "string",
          "description": "fallback 的别名。"
        },
        "locales": {
          "$ref": "#/definitions/localeSources"
        },
        "files": {
          "$ref": "#/definitions/localeSources"
        },
        "sources": {
          "$ref": "#/definitions/localeSources"
        }
      },
      "additionalProperties": true
    },
    "localeSources": {
      "type": "object",
      "description": "语言代码到外部 YAML/JSON 文件或内联翻译对象的映射。",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object"
          }
        ]
      }
    },
    "style": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "fg": {
              "type": "string"
            },
            "bg": {
              "type": "string"
            },
            "bold": {
              "type": "boolean"
            },
            "dim": {
              "type": "boolean"
            },
            "italic": {
              "type": "boolean"
            },
            "underline": {
              "type": "boolean"
            },
            "inverse": {
              "type": "boolean"
            },
            "when": {},
            "condition": {},
            "value": {},
            "else": {}
          },
          "additionalProperties": true
        }
      ]
    },
    "layout": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/layout"
          }
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "text",
                "input",
                "column",
                "row",
                "panel",
                "popup",
                "progress",
                "list",
                "divider",
                "spacer"
              ]
            },
            "value": {
              "$ref": "#/definitions/value"
            },
            "message": {
              "$ref": "#/definitions/value"
            },
            "bind": {
              "type": "string"
            },
            "placeholder": {
              "$ref": "#/definitions/value"
            },
            "placeholderStyle": {
              "$ref": "#/definitions/style"
            },
            "template": {
              "type": "string"
            },
            "visible": {},
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/layout"
              }
            },
            "child": {
              "$ref": "#/definitions/layout"
            },
            "items": {
              "$ref": "#/definitions/value"
            },
            "selected": {
              "$ref": "#/definitions/value"
            },
            "label": {
              "$ref": "#/definitions/value"
            },
            "max": {
              "$ref": "#/definitions/value"
            },
            "showValue": {
              "$ref": "#/definitions/value"
            },
            "filled": {
              "$ref": "#/definitions/value"
            },
            "empty": {
              "$ref": "#/definitions/value"
            },
            "description": {
              "$ref": "#/definitions/value"
            },
            "style": {
              "$ref": "#/definitions/style"
            },
            "padding": {
              "$ref": "#/definitions/value"
            },
            "gap": {
              "type": [
                "number",
                "string"
              ]
            },
            "flex": {
              "type": [
                "boolean",
                "number"
              ]
            },
            "title": {
              "$ref": "#/definitions/value"
            },
            "border": {
              "type": [
                "boolean",
                "string"
              ]
            },
            "borderStyle": {
              "type": "string"
            },
            "titleStyle": {
              "type": "string"
            },
            "marker": {
              "$ref": "#/definitions/value"
            },
            "normalMarker": {
              "$ref": "#/definitions/value"
            },
            "selectedStyle": {
              "type": "string"
            },
            "itemStyle": {
              "type": "string"
            },
            "disabledStyle": {
              "type": "string"
            },
            "emptyText": {
              "$ref": "#/definitions/value"
            },
            "emptyStyle": {
              "type": "string"
            },
            "width": {
              "type": [
                "number",
                "string"
              ]
            },
            "height": {
              "type": [
                "number",
                "string"
              ]
            },
            "lines": {
              "type": [
                "number",
                "string"
              ]
            },
            "character": {
              "$ref": "#/definitions/value"
            },
            "cursor": {
              "type": "boolean"
            },
            "mask": {
              "type": [
                "boolean",
                "string"
              ]
            },
            "focus": {
              "$ref": "#/definitions/value"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "actionList": {
      "oneOf": [
        {
          "$ref": "#/definitions/action"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/action"
          }
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "pop",
            "refresh",
            "quit"
          ]
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "type": "string"
            },
            "set": {
              "$ref": "#/definitions/value"
            },
            "move": {
              "$ref": "#/definitions/value"
            },
            "toggle": {
              "$ref": "#/definitions/value"
            },
            "remove": {
              "$ref": "#/definitions/value"
            },
            "append": {
              "$ref": "#/definitions/value"
            },
            "backspace": {
              "$ref": "#/definitions/value"
            },
            "push": {
              "$ref": "#/definitions/value"
            },
            "go": {
              "$ref": "#/definitions/value"
            },
            "replace": {
              "$ref": "#/definitions/value"
            },
            "reset": {
              "$ref": "#/definitions/value"
            },
            "pop": {
              "$ref": "#/definitions/value"
            },
            "quit": {
              "$ref": "#/definitions/value"
            },
            "call": {
              "$ref": "#/definitions/callAction"
            },
            "refresh": {
              "$ref": "#/definitions/value"
            },
            "notify": {
              "$ref": "#/definitions/value"
            },
            "if": {
              "$ref": "#/definitions/ifAction"
            },
            "then": {
              "$ref": "#/definitions/actionList"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "callAction": {
      "oneOf": [
        {
          "type": "string",
          "description": "调用启动器注册的 service 名称。"
        },
        {
          "type": "object",
          "properties": {
            "service": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "with": {
              "$ref": "#/definitions/value"
            },
            "sh": {
              "$ref": "#/definitions/value",
              "description": "通过当前 shell 执行的命令字符串。"
            },
            "command": {
              "$ref": "#/definitions/value",
              "description": "直接执行的外部命令。"
            },
            "args": {
              "$ref": "#/definitions/value"
            },
            "cwd": {
              "$ref": "#/definitions/value"
            },
            "env": {
              "type": "object"
            },
            "stdio": {
              "$ref": "#/definitions/value"
            },
            "blocking": {
              "$ref": "#/definitions/value"
            },
            "wait": {
              "$ref": "#/definitions/value"
            },
            "result": {
              "type": "string"
            },
            "stdout": {
              "type": "string"
            },
            "stderr": {
              "type": "string"
            },
            "lines": {
              "type": "string"
            },
            "stderrLines": {
              "type": "string"
            },
            "json": {
              "type": "string"
            },
            "code": {
              "type": "string"
            },
            "check": {
              "$ref": "#/definitions/value"
            },
            "interpreter": {
              "$ref": "#/definitions/value"
            },
            "maxBuffer": {
              "$ref": "#/definitions/value"
            },
            "onLine": {
              "$ref": "#/definitions/actionList"
            },
            "onExit": {
              "$ref": "#/definitions/actionList"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "ifAction": {
      "type": "object",
      "properties": {
        "condition": {},
        "then": {
          "$ref": "#/definitions/actionList"
        },
        "else": {
          "$ref": "#/definitions/actionList"
        }
      },
      "required": [
        "condition"
      ],
      "additionalProperties": true
    },
    "page": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "$ref": "#/definitions/value"
        },
        "state": {
          "type": "object"
        },
        "layout": {
          "$ref": "#/definitions/layout"
        },
        "keys": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/actionList"
          }
        },
        "on": {
          "type": "object",
          "properties": {
            "enter": {
              "$ref": "#/definitions/actionList"
            },
            "resume": {
              "$ref": "#/definitions/actionList"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
